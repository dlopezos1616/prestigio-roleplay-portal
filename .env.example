# ============================================================
# Prestigio Roleplay Portal — Variables de Entorno (Ejemplo)
# ============================================================
# Copia este archivo a .env y rellena con tus credenciales reales
# cp .env.example .env

# ----- Base de datos (PostgreSQL) -----
# Usamos PostgreSQL tanto en desarrollo como en producción.
# Recomendado: crea una base de datos gratuita en https://neon.tech
#
# Desarrollo (crea un branch separado en Neon para no tocar producción):
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
#
# Producción (otro branch o proyecto en Neon):
# DATABASE_URL="postgresql://user:password@host/prod-dbname?sslmode=require"

# ----- NextAuth.js -----
NEXTAUTH_URL="http://localhost:3000"
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET="genera-un-secreto-aleatorio-aqui"

# ----- Discord OAuth2 -----
# Obtén estas credenciales en: https://discord.com/developers/applications
DISCORD_CLIENT_ID="tu_discord_client_id"
DISCORD_CLIENT_SECRET="tu_discord_client_secret"

# ID del servidor de Discord (para verificación de miembro)
DISCORD_GUILD_ID="id_de_tu_servidor_discord"

# ----- z-ai-web-dev-sdk (Opcional) -----
# Para chat widget IA, generación de imágenes, TTS, etc.
ZAI_API_KEY="tu_zai_api_key"

# ----- Configuración del servidor -----
NODE_ENV="development"
PORT=3000
