generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  discordId     String   @unique
  username      String
  avatar        String?
  role          String   @default("USER") // ADMIN, STAFF, USER
  accessToken   String?
  refreshToken  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  whitelistApps     WhitelistApplication[] @relation("UserWhitelistApps")
  reviewedApps      WhitelistApplication[] @relation("UserReviewedApps")
  tasks             Task[]
  uploadedImages    GalleryImage[]
  auditLogs         AuditLog[]
  notifications     Notification[]
}

model WhitelistApplication {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("UserWhitelistApps", fields: [userId], references: [id], onDelete: Cascade)
  answer1       String   // Power Gaming
  answer2       String   // Meta Gaming
  answer3       String   // OOC vs IC
  answer4       String   // NVL and VDM
  answer5       String   // Difficult decision scenario
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  attemptNumber Int      @default(1)
  reviewerId    String?
  reviewer      User?    @relation("UserReviewedApps", fields: [reviewerId], references: [id])
  reviewedAt    DateTime?
  rejectReason  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Task {
  id          String   @id @default(cuid())
  title       String
  assigneeId  String?
  assignee    User?    @relation(fields: [assigneeId], references: [id])
  status      String   @default("TODO") // TODO, IN_PROGRESS, DONE, BLOCKED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     DateTime?
  notes       String?
  date        String   // YYYY-MM-DD format for daily template
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryImage {
  id          String   @id @default(cuid())
  url         String
  title       String?
  description String?
  eventTag    String?
  uploadedById String
  uploadedBy  User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  entityType String?
  entityId   String?
  metadata   String?  // JSON string
  createdAt  DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // WHITELIST_SUBMITTED, WHITELIST_APPROVED, WHITELIST_REJECTED, TASK_ASSIGNED, etc.
  payload   String?   // JSON string
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model SiteConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
